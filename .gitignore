# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw datasets can be large
data/raw/

# Results — optionally ignore if large, comment out if you want to track them
# data/processed/
# simulations/*/results/
# empirical/*/results/

# Environment
.env
*.env
conda-lock.yml

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Coverage
.coverage
htmlcov/

# Figures — comment out if you want to track generated figures
# figures/

# Simulation run logs — transient stdout/stderr from the queue scripts.
# The .err.log files are almost entirely TensorFlow startup warnings.
simulations/*.log
simulations/*.err.log
empirical-icdm/*.log
empirical-icdm/*.err.log

# LaTeX build artifacts — regenerated by build-jrssb.ps1, never edited by hand.
# The compiled PDFs (jrssb-main.pdf, jrssb-supp.pdf) ARE tracked: they are the
# submission deliverable.
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.nav
*.snm
*.synctex.gz
*.fls
*.fdb_latexmk
*.ttt
*.fff
missfont.log
